# ============================================================
# 成都旅游智能体 · 环境变量配置模板
# 复制本文件为 .env 并填入真实值
# ============================================================

# ===== LLM（DeepSeek）=====
# 在 https://platform.deepseek.com/ 申请 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3

# ===== 高德地图 API（POI 拉取）=====
AMAP_API_KEY=你的高德Key

# ===== MySQL（业务数据）=====
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=chengdu123
MYSQL_DB=chengdu_travel
MYSQL_CHARSET=utf8mb4

# ===== Redis（加速层）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== RAG（LlamaIndex + Milvus Lite）=====
RAG_ENGINE=llamaindex
RAG_TOP_K=5
MILVUS_DB_PATH=./data/milvus/milvus_chengdu.db
MILVUS_COLLECTION_SPOTS=chengdu_spots
MILVUS_DIM=1024

# ===== LTM 长期用户画像记忆 =====
MILVUS_COLLECTION_LTM=user_ltm_v1
LTM_SEMANTIC_TOP_K=3
LTM_DEDUP_THRESHOLD=0.92

# ===== Embedding 模型 =====
EMBED_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBED_DEVICE=cpu

# ===== 服务端口 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=./logs

# ===== LangSmith 全链路追踪（可选）=====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=chengdu-travel-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ===== Checkpointer 跨会话持久化 =====
# 可选值：sqlite | memory | redis | postgres
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_DIR=./data/checkpoints
CHECKPOINT_SQLITE_PATH=./data/checkpoints/langgraph_checkpoints.db
CHECKPOINT_REDIS_TTL=3600
CHECKPOINT_POSTGRES_URI=postgresql+psycopg://chengdu:chengdu123@127.0.0.1:5432/chengdu_travel

# ===== Rolling Summary 阈值 =====
ROLLING_WINDOW_MAX_TOKENS=12000
ROLLING_RECENT_ROUNDS=6
